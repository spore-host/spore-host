{
  "$comment": "SimulateCustomPolicy cases for the portal role (iam/policies/portal-launch-role.json). Rules are in iam/simulate.ts: at least one denied case, an allowed case per inventory action, and a denied case for every action of every conditioned statement. realCall:true marks cases the real-AWS e2e harness also makes for real (e2e-aws/grants.ts). 111122223333 is AWS's documentation account id; the live job substitutes the caller's. The 1.0 portal is READ-ONLY (#645, re-scoped 2026-11-14), so RunInstances, CreateTags, iam:PassRole, StartSession, TerminateSession and SendCommand are REQUIRED NEGATIVE cases, denied even on a spawn-managed instance (#701, #678), as are Stop, Start and Terminate (removed from the live role on 2026-11-10). The harness proves the list allowed and launch, tag, session, stop, start and terminate denied with real calls. Actions return after 1.0 (#686, #687, #689); those PRs turn the matching denials into allowed cases.",
  "policyFile": "portal-launch-role.json",
  "account": "111122223333",
  "sporedInstanceRole": "spored-instance-role",
  "cases": [
    {
      "name": "list instances",
      "action": "ec2:DescribeInstances",
      "resource": "*",
      "expect": "allowed",
      "realCall": true
    },
    {
      "name": "read instance tags",
      "action": "ec2:DescribeTags",
      "resource": "*",
      "expect": "allowed"
    },
    {
      "name": "read Spot prices",
      "action": "ec2:DescribeSpotPriceHistory",
      "resource": "*",
      "expect": "allowed"
    },
    {
      "name": "read a quota",
      "action": "servicequotas:GetServiceQuota",
      "resource": "arn:aws:servicequotas:us-east-1:${ACCOUNT_ID}:ec2/L-1216C47A",
      "expect": "allowed"
    },
    {
      "name": "list quotas",
      "action": "servicequotas:ListServiceQuotas",
      "resource": "*",
      "expect": "allowed"
    },
    {
      "name": "never launch from the browser (read-only portal, #645)",
      "action": "ec2:RunInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/*",
      "expect": "denied"
    },
    {
      "name": "never tag at launch",
      "action": "ec2:CreateTags",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "ec2:CreateAction": "RunInstances"
      },
      "expect": "denied"
    },
    {
      "name": "never tag a spawn-managed instance (#678)",
      "action": "ec2:CreateTags",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "aws:ResourceTag/spawn:managed": "true"
      },
      "expect": "denied"
    },
    {
      "name": "never tag an instance spawn did not launch, e.g. spawn:managed=true onto it (#678)",
      "action": "ec2:CreateTags",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never pass spored's role to EC2",
      "action": "iam:PassRole",
      "resource": "arn:aws:iam::${ACCOUNT_ID}:role/${SPORED_INSTANCE_ROLE}",
      "context": {
        "iam:PassedToService": "ec2.amazonaws.com"
      },
      "expect": "denied"
    },
    {
      "name": "never pass any other role",
      "action": "iam:PassRole",
      "resource": "arn:aws:iam::${ACCOUNT_ID}:role/AdminRole",
      "context": {
        "iam:PassedToService": "ec2.amazonaws.com"
      },
      "expect": "denied"
    },
    {
      "name": "never open a command line, even on a spawn-managed instance (#701)",
      "action": "ssm:StartSession",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "ssm:resourceTag/spawn:managed": "true"
      },
      "expect": "denied"
    },
    {
      "name": "never open a command line on any other instance",
      "action": "ssm:StartSession",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never use the shell document",
      "action": "ssm:StartSession",
      "resource": "arn:aws:ssm:us-east-1:${ACCOUNT_ID}:document/SSM-SessionManagerRunShell",
      "expect": "denied"
    },
    {
      "name": "never close a session",
      "action": "ssm:TerminateSession",
      "resource": "arn:aws:ssm:us-east-1:${ACCOUNT_ID}:session/spore-portal-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never run a command on an instance (spawn-ts's extend reload)",
      "action": "ssm:SendCommand",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never terminate from the browser, even a spawn-managed instance (#678)",
      "action": "ec2:TerminateInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "aws:ResourceTag/spawn:managed": "true"
      },
      "expect": "denied"
    },
    {
      "name": "terminate an instance spawn did not launch",
      "action": "ec2:TerminateInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "terminate an instance tagged spawn:managed=false",
      "action": "ec2:TerminateInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "aws:ResourceTag/spawn:managed": "false"
      },
      "expect": "denied"
    },
    {
      "name": "never stop from the browser, even a spawn-managed instance (#678)",
      "action": "ec2:StopInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "aws:ResourceTag/spawn:managed": "true"
      },
      "expect": "denied"
    },
    {
      "name": "stop an instance spawn did not launch",
      "action": "ec2:StopInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never start from the browser, even a spawn-managed instance (#678)",
      "action": "ec2:StartInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "context": {
        "aws:ResourceTag/spawn:managed": "true"
      },
      "expect": "denied"
    },
    {
      "name": "start an instance spawn did not launch",
      "action": "ec2:StartInstances",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never create IAM roles",
      "action": "iam:CreateRole",
      "resource": "arn:aws:iam::${ACCOUNT_ID}:role/anything",
      "expect": "denied"
    },
    {
      "name": "never change an instance's attributes",
      "action": "ec2:ModifyInstanceAttribute",
      "resource": "arn:aws:ec2:us-east-1:${ACCOUNT_ID}:instance/i-0123456789abcdef0",
      "expect": "denied"
    },
    {
      "name": "never read S3",
      "action": "s3:GetObject",
      "resource": "arn:aws:s3:::any-bucket/any-key",
      "expect": "denied"
    }
  ]
}
