{
  "$comment": "Every foreground/background pair a portal component draws, checked against WCAG 2.2 AA by gates/contrast.test.ts. min 4.5 = text (SC 1.4.3); min 3 = non-text: control boundaries, focus rings, status graphics (SC 1.4.11). A --color-* token in no pair must be listed in exempt with a reason, or the gate fails.",
  "pairs": [
    { "fg": "--color-text", "bg": "--color-surface", "min": 4.5, "use": "body text" },
    { "fg": "--color-text", "bg": "--color-surface-subtle", "min": 4.5, "use": "body text on page background and panels" },
    { "fg": "--color-text", "bg": "--color-surface-sunken", "min": 4.5, "use": "text on table header and command-line well" },
    { "fg": "--color-text", "bg": "--color-primary-subtle", "min": 4.5, "use": "selected radio card, info alert body" },
    { "fg": "--color-text", "bg": "--color-warning-subtle", "min": 4.5, "use": "warning alert body" },
    { "fg": "--color-text", "bg": "--color-danger-subtle", "min": 4.5, "use": "danger alert body" },
    { "fg": "--color-text", "bg": "--color-success-subtle", "min": 4.5, "use": "success alert body" },
    { "fg": "--color-text-muted", "bg": "--color-surface", "min": 4.5, "use": "hints, metadata" },
    { "fg": "--color-text-muted", "bg": "--color-surface-subtle", "min": 4.5, "use": "hints on page background" },
    { "fg": "--color-text-muted", "bg": "--color-surface-sunken", "min": 4.5, "use": "metadata in table header, skeleton label" },
    { "fg": "--color-text-muted", "bg": "--color-primary-subtle", "min": 4.5, "use": "radio card spec line when selected" },
    { "fg": "--color-primary", "bg": "--color-surface", "min": 4.5, "use": "links, secondary button text" },
    { "fg": "--color-primary", "bg": "--color-surface-subtle", "min": 4.5, "use": "links on page background" },
    { "fg": "--color-primary", "bg": "--color-primary-subtle", "min": 4.5, "use": "info alert title, active nav item" },
    { "fg": "--color-primary-hover", "bg": "--color-primary-subtle", "min": 4.5, "use": "hovered link on subtle" },
    { "fg": "--color-on-primary", "bg": "--color-primary", "min": 4.5, "use": "primary button label" },
    { "fg": "--color-on-primary", "bg": "--color-primary-hover", "min": 4.5, "use": "primary button label, hovered" },
    { "fg": "--color-on-primary", "bg": "--color-danger", "min": 4.5, "use": "danger button label" },
    { "fg": "--color-on-primary", "bg": "--color-danger-hover", "min": 4.5, "use": "danger button label, hovered" },
    { "fg": "--color-success", "bg": "--color-success-subtle", "min": 4.5, "use": "success alert title, Running pill" },
    { "fg": "--color-warning", "bg": "--color-warning-subtle", "min": 4.5, "use": "warning alert title, time-left text near deadline" },
    { "fg": "--color-warning", "bg": "--color-surface", "min": 4.5, "use": "money-still-being-spent text on white" },
    { "fg": "--color-danger", "bg": "--color-danger-subtle", "min": 4.5, "use": "danger alert title, field error on tinted panel" },
    { "fg": "--color-danger", "bg": "--color-surface", "min": 4.5, "use": "field error text, danger link" },
    { "fg": "--color-border-control", "bg": "--color-surface", "min": 3, "use": "field, checkbox and secondary button boundary" },
    { "fg": "--color-border-control", "bg": "--color-surface-subtle", "min": 3, "use": "field boundary on a subtle panel" },
    { "fg": "--color-border-control", "bg": "--color-surface-sunken", "min": 3, "use": "control boundary in the command-line well" },
    { "fg": "--color-focus", "bg": "--color-focus-offset", "min": 3, "use": "focus ring against its white offset" },
    { "fg": "--color-focus", "bg": "--color-surface-subtle", "min": 3, "use": "focus ring offset edge on page background" },
    { "fg": "--color-primary", "bg": "--color-surface-sunken", "min": 3, "use": "selected radio card boundary, time bar on track" },
    { "fg": "--color-neutral-graphic", "bg": "--color-surface-sunken", "min": 3, "use": "time-left bar fill, plenty left" },
    { "fg": "--color-neutral-graphic", "bg": "--color-surface", "min": 3, "use": "neutral status dot" },
    { "fg": "--color-warning-graphic", "bg": "--color-surface-sunken", "min": 3, "use": "time-left bar fill, under 30 minutes" },
    { "fg": "--color-warning-graphic", "bg": "--color-warning-subtle", "min": 3, "use": "warning alert edge and icon" },
    { "fg": "--color-danger", "bg": "--color-surface-sunken", "min": 3, "use": "time-left bar fill, under 10 minutes" },
    { "fg": "--color-success", "bg": "--color-surface", "min": 3, "use": "Running status dot" },
    { "fg": "--color-info", "bg": "--color-info-subtle", "min": 4.5, "use": "info alert title and edge" }
  ],
  "exempt": {
    "--color-border": "Decorative dividers between regions only. Never a control boundary, so SC 1.4.11 does not apply; controls use --color-border-control."
  }
}
