{
  "name": "spore-host-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "spore.host default portal — a browser mirror of the CLI tools, driven by the @spore-host/*-ts libraries.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && ./deploy.sh"
  },
  "dependencies": {
    "@spore-host/lagotto-ts": "^0.3.0",
    "@spore-host/spawn-ts": "^0.8.1",
    "@spore-host/truffle-ts": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
