{
  "name": "spore-host-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "spore.host website. The portal at /app is a static placeholder while it is rebuilt (spore-host#645); the old portal source is kept unbuilt in legacy-app/.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && ./deploy.sh",
    "portal:dev": "vite --config portal/vite.config.ts --mode gate",
    "portal:typecheck": "tsc --noEmit -p portal/tsconfig.json",
    "portal:test": "vitest run --config portal/vitest.config.ts",
    "portal:build": "vite build --config portal/vite.config.ts",
    "portal:build:gate": "vite build --config portal/vite.config.ts --mode gate",
    "portal:iam:update": "PORTAL_IAM_UPDATE=1 vitest run --config portal/vitest.config.ts gates/iam-inventory.test.ts",
    "portal:e2e": "playwright test --config portal/playwright.config.ts",
    "portal:gates": "npm run portal:typecheck && npm run portal:test && npm run portal:e2e",
    "portal:e2e-aws": "vitest run --config portal/vitest.config.ts e2e-aws/harness.live.test.ts",
    "portal:e2e-aws:sweep": "vitest run --config portal/vitest.config.ts e2e-aws/sweep.live.test.ts"
  },
  "dependencies": {
    "@spore-host/lagotto-ts": "^0.2.0",
    "@spore-host/spawn-ts": "^0.6.1",
    "@spore-host/truffle-ts": "^0.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "3.1095.0",
    "@aws-sdk/client-ssm": "3.1095.0",
    "@aws-sdk/client-sts": "3.1095.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
