        "spore-host/spore-host:.github/workflows/deploy-site.yaml",
        "spore-host/spore-host:.github/workflows/docs.yaml"
      ],
      "codified_in": null,
      "why": "Deploys spore.host and docs.spore.host from a push to main (or a manual run on main). Neither job sets an environment, so GitHub issues sub ref:refs/heads/main. A manual run from any other branch must be refused.",
      "trust": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::966362334030:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                "token.actions.githubusercontent.com:sub": "repo:spore-host/spore-host:ref:refs/heads/main"
              }
            }
          }
        ]
      }
    },
